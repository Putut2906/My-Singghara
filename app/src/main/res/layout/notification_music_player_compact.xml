<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notif_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_notification_player"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="4dp"
    android:paddingEnd="8dp"
    android:paddingBottom="4dp">

    <ImageView
        android:id="@+id/notif_album_art"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_notification_art"
        android:contentDescription="Sampul album"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_notif_music" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/notif_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="Judul lagu"
            android:textColor="@color/notif_text_primary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/notif_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Artis"
            android:textColor="@color/notif_text_secondary"
            android:textSize="10sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/notif_play_pause"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_notification_play"
        android:contentDescription="Jeda"
        android:padding="9dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_notif_pause" />

    <ImageButton
        android:id="@+id/notif_close"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_marginStart="2dp"
        android:background="@drawable/bg_notification_button"
        android:contentDescription="Tutup notifikasi"
        android:padding="6dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_notif_close" />
</LinearLayout>
