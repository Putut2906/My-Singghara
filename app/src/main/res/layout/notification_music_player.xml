<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notif_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_notification_player"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="10dp">

    <!-- Sampul, judul, dan tombol acak -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/notif_album_art"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_notification_art"
            android:contentDescription="Sampul album"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_notif_music" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/notif_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="Judul lagu"
                android:textColor="@color/notif_text_primary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/notif_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Artis"
                android:textColor="@color/notif_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/notif_shuffle"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_notification_button"
            android:contentDescription="Acak"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_notif_shuffle" />
    </LinearLayout>

    <!-- Waktu, bilah kemajuan, dan tombol tutup -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/notif_elapsed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="30dp"
            android:text="0:00"
            android:textColor="@color/notif_text_secondary"
            android:textSize="9sp" />

        <ProgressBar
            android:id="@+id/notif_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:max="1000"
            android:progress="0"
            android:progressBackgroundTint="@color/notif_track"
            android:progressTint="@color/notif_accent" />

        <TextView
            android:id="@+id/notif_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:minWidth="30dp"
            android:text="0:00"
            android:textColor="@color/notif_text_secondary"
            android:textSize="9sp" />

        <ImageButton
            android:id="@+id/notif_close"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="2dp"
            android:background="@drawable/bg_notification_button"
            android:contentDescription="Tutup notifikasi"
            android:padding="5dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_notif_close" />
    </LinearLayout>

    <!-- Tombol kontrol pemutaran -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/notif_prev"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_notification_button"
            android:contentDescription="Lagu sebelumnya"
            android:padding="11dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_notif_prev" />

        <ImageButton
            android:id="@+id/notif_play_pause"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="18dp"
            android:background="@drawable/bg_notification_play"
            android:contentDescription="Jeda"
            android:padding="14dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_notif_pause" />

        <ImageButton
            android:id="@+id/notif_next"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_notification_button"
            android:contentDescription="Lagu berikutnya"
            android:padding="11dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_notif_next" />
    </LinearLayout>
</LinearLayout>
